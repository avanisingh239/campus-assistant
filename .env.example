# --- Supabase ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only — never expose via NEXT_PUBLIC_*, never send to
# the browser. Used by the ingestion pipeline (lib/supabase/admin.ts) to write
# to `messages` and `announcements`, since those tables have no INSERT policy
# for the `authenticated` role (see supabase/schema.sql) — writes go through
# this privileged server-side client instead.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini ---
# aistudio.google.com/apikey -> Create API key (free tier, no billing account
# required). Used by lib/ai/gemini.ts for message categorization/extraction
# (see docs/ai-contracts.md).
#
# A real quota check against the live Google AI Studio console (not just
# the SDK's own docs) found this project's key capped at roughly 5
# requests/minute and ~100/day — tight enough that a single WhatsApp .txt
# batch upload can exhaust it in one submission. Three mitigations, all in
# this codebase already: lib/ingestion/throttle.ts spaces out a batch's
# calls to stay under the per-minute ceiling; lib/ai/extract.ts retries a
# 429/503 with backoff and rotates to the next configured key on a 429
# before giving up; and the "Failed" result state on /student/ingest shows
# a specific "we're getting a lot of requests right now" message (with a
# Retry button) rather than a generic crash when every key is exhausted.
#
# GEMINI_API_KEYS (preferred): a comma-separated list of keys, e.g.
#   GEMINI_API_KEYS=AIza...key1,AIza...key2,AIza...key3
# Each additional free key adds its OWN independent 5 RPM / ~100 RPD
# budget — lib/ai/extract.ts rotates through all of them on a 429 before
# falling back to backoff-retrying the last one. Get more free keys the
# same way as the first, from a different Google account if you want
# fully separate quotas (aistudio.google.com/apikey).
#
# GEMINI_API_KEY (older, single-key variable): still works on its own if
# GEMINI_API_KEYS isn't set — kept for backward compatibility, not
# combined with GEMINI_API_KEYS if both happen to be set (GEMINI_API_KEYS
# wins). Fine to keep using this if one key's quota is enough for you.
GEMINI_API_KEYS=
GEMINI_API_KEY=

# --- WhatsApp Cloud API webhook (app/api/whatsapp-webhook/route.ts) ---
# WHATSAPP_VERIFY_TOKEN: any string you make up yourself — enter the exact
# same value in the Meta App Dashboard's webhook setup, alongside this
# route's URL. Required for the GET verification handshake to succeed.
WHATSAPP_VERIFY_TOKEN=

# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID: from the Meta App
# Dashboard's WhatsApp -> API Setup page. Optional — only needed if you
# want the bot to send a confirmation reply back after ingesting a
# message; the webhook's actual job (feeding lib/ingestion/ingest.ts)
# works fine with these left blank.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
