# --- Supabase ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only — never expose via NEXT_PUBLIC_*, never send to
# the browser. Used by the ingestion pipeline (lib/supabase/admin.ts) to write
# to `messages` and `announcements`, since those tables have no INSERT policy
# for the `authenticated` role (see supabase/schema.sql) — writes go through
# this privileged server-side client instead.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini ---
# aistudio.google.com/apikey -> Create API key (free tier, no billing account
# required). Used by lib/ai/gemini.ts for message categorization/extraction
# (see docs/ai-contracts.md). Free-tier requests are capped at roughly
# 10/minute — lib/ai/extract.ts retries a 429/503 with backoff before
# surfacing a "try again in a moment" error.
GEMINI_API_KEY=

# --- WhatsApp Cloud API webhook (app/api/whatsapp-webhook/route.ts) ---
# WHATSAPP_VERIFY_TOKEN: any string you make up yourself — enter the exact
# same value in the Meta App Dashboard's webhook setup, alongside this
# route's URL. Required for the GET verification handshake to succeed.
WHATSAPP_VERIFY_TOKEN=

# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID: from the Meta App
# Dashboard's WhatsApp -> API Setup page. Optional — only needed if you
# want the bot to send a confirmation reply back after ingesting a
# message; the webhook's actual job (feeding lib/ingestion/ingest.ts)
# works fine with these left blank.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
